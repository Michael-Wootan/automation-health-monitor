# GitHub token with actions:read on the primary repo. In GitHub Actions the
# built-in GITHUB_TOKEN works for the repo the workflow runs in.
GITHUB_TOKEN=ghp_your_token_here
# Optional: fine-grained PAT (Actions read + Metadata read) for repos listed in extraRepos.
# Falls back to GITHUB_TOKEN.
EXTRA_REPOS_TOKEN=

# Optional overrides (otherwise taken from the config file / Actions environment)
MONITOR_CONFIG=monitor.config.json
MONITOR_REPO=your-org/store-automations
STORE_NAME=Acme Store
REPORT_DIR=reports

# SMTP for the report email (Gmail app password works with the defaults)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=reports@example.com
SMTP_PASS=your_app_password
EMAIL_FROM=reports@example.com
EMAIL_NOTIFY=owner@example.com
